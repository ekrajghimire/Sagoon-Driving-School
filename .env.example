# ─────────────────────────────────────────────────────────────────────────────
# Sagoon Driving School — environment variables
# Copy to .env for local development. On your host (Vercel/Netlify) add the same
# keys in the project's Environment Variables settings. Never commit real values.
# Everything below uses free services. See docs/SETUP_AND_DEPLOYMENT.md.
# ─────────────────────────────────────────────────────────────────────────────

# Site address — OPTIONAL on Vercel. If left out, the site uses its Vercel address
# automatically (your custom domain or *.vercel.app). Set it only to force a specific
# domain, e.g. https://www.sagoondrivingschool.com.au (no trailing slash), then redeploy.
NEXT_PUBLIC_SITE_URL=""
NEXT_PUBLIC_CONTACT_EMAIL="hello@sagoondrivingschool.com.au"

# Database — free Postgres (Neon recommended). Use the *pooled* URL for the app
# and the *direct* URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.ap-southeast-2.aws.neon.tech/neondb?sslmode=require"

# Auth (Better Auth). Generate a secret with:  openssl rand -base64 32
# REQUIRED online: keeps people logged in securely. Never share it.
BETTER_AUTH_SECRET=""
# OPTIONAL — defaults to the site address above.
BETTER_AUTH_URL=""
# Comma-separated emails that become OWNER automatically when they register.
OWNER_EMAIL="you@gmail.com"

# Google login (optional, free) — Google Cloud Console → OAuth client (Web).
# Authorised redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Calendar sync (free) — service account with access to your calendar.
GOOGLE_CALENDAR_ID="you@gmail.com"                 # or the calendar's ID from its settings
GOOGLE_SERVICE_ACCOUNT_EMAIL="sagoon-calendar@your-project.iam.gserviceaccount.com"
# Paste the private_key from the JSON key file, keeping the \n sequences, in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Email (free) — any SMTP. Gmail: smtp.gmail.com / 465 / your Gmail / a 16-char App Password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASS=""
EMAIL_FROM="Sagoon Driving School <you@gmail.com>"

# Scheduled jobs (reminders, review requests, calendar retries). Any long random string.
CRON_SECRET=""

# Analytics (optional) — only load after visitors accept cookies.
NEXT_PUBLIC_GA_ID=""          # e.g. G-XXXXXXXXXX
NEXT_PUBLIC_FB_PIXEL_ID=""
