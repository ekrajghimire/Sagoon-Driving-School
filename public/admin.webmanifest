{
  "id": "/admin",
  "name": "Sagoon Admin",
  "short_name": "Sagoon Admin",
  "description": "Bookings, schedule and alerts for Sagoon Driving School",
  "start_url": "/admin",
  "scope": "/admin",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#0b4f7c",
  "icons": [
    { "src": "/icons/192", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/512", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "/admin", "icons": [{ "src": "/icons/192", "sizes": "192x192" }] },
    { "name": "Bookings", "url": "/admin/bookings", "icons": [{ "src": "/icons/192", "sizes": "192x192" }] },
    { "name": "New booking", "url": "/admin/bookings/new", "icons": [{ "src": "/icons/192", "sizes": "192x192" }] }
  ]
}
